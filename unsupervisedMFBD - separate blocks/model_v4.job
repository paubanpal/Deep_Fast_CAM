# Clean environment
module purge 2>/dev/null
# Source Conda from your scratch directory
source /scratch/paulabp/miniconda3/etc/profile.d/conda.sh
# Activate your environment
conda activate tfm_conda_venv

cd "/scratch/paulabp/TFM/repository/Deep_Fast_CAM/unsupervisedMFBD - separate blocks"

srun python model_v4.py 